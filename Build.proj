<Project DefaultTargets="Default">
  <Import Project="Directory.Build.props" />
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <OSArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</OSArchitecture>
  </PropertyGroup>
  <PropertyGroup>
    <IsWinX64      Condition="$([MSBuild]::IsOsPlatform('Windows')) and $(OSArchitecture) == X64">true</IsWinX64>
    <IsLinuxX64    Condition="$([MSBuild]::IsOsPlatform('Linux'))   and $(OSArchitecture) == X64">true</IsLinuxX64>
    <IsLinuxArm    Condition="$([MSBuild]::IsOsPlatform('Linux'))   and $(OSArchitecture) == Arm">true</IsLinuxArm>
    <IsLinuxArm64  Condition="$([MSBuild]::IsOsPlatform('Linux'))   and $(OSArchitecture) == Arm64">true</IsLinuxArm64>
    <IsOsXX64      Condition="$([MSBuild]::IsOsPlatform('OSX'))     and $(OSArchitecture) == X64">true</IsOsXX64>
    <IsOsXArm64    Condition="$([MSBuild]::IsOsPlatform('OSX'))     and $(OSArchitecture) == Arm64">true</IsOsXArm64>
  </PropertyGroup>
  <PropertyGroup>
    <WinX64PublishAot     Condition="'$(PublishAot)'=='true'">$(IsWinX64)</WinX64PublishAot>
    <LinuxX64PublishAot   Condition="'$(PublishAot)'=='true'">$(IsLinuxX64)</LinuxX64PublishAot>
    <LinuxArmPublishAot   Condition="'$(PublishAot)'=='true'">$(IsLinuxArm)</LinuxArmPublishAot>
    <LinuxArm64PublishAot Condition="'$(PublishAot)'=='true'">$(IsLinuxArm64)</LinuxArm64PublishAot>
    <OsXX64PublishAot     Condition="'$(PublishAot)'=='true'">$(IsOsXX64)</OsXX64PublishAot>
    <OsXArm64PublishAot   Condition="'$(PublishAot)'=='true'">$(IsOsXArm64)</OsXArm64PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <SourceArtifacts Include="**/*" Exclude="**/bin/**;**/obj/**;**/.vs/**;**/.git/**;**/$(ArtifactsPath)/**;lib/roms/**;src/tools/Installer/bin/**;src/tools/Installer/net10.0/**" />
  </ItemGroup>
  <Target Name="Clean">
    <RemoveDir Directories="$(ArtifactsPath);src/tools/Installer/bin;src/tools/Installer/net10.0" />
  </Target>
  <Target Name="PublishWinX64" Condition="'$(IsWinX64)'=='true'">
    <MSBuild Projects="src/win-x64/EMU7800.Win32.csproj" Targets="Restore" />
    <MSBuild Projects="src/win-x64/EMU7800.Win32.csproj" Targets="Publish" Properties="Configuration=Release;PublishAot=$(WinX64PublishAot)" />
  </Target>
  <Target Name="PublishWinX64Sdl3" Condition="'$(IsWinX64)'=='true'">
    <MSBuild Projects="src/win-x64-sdl3/EMU7800.WinSDL3.csproj" Targets="Restore" />
    <MSBuild Projects="src/win-x64-sdl3/EMU7800.WinSDL3.csproj" Targets="Publish" Properties="Configuration=Release;PublishAot=$(WinX64PublishAot)" />
  </Target>
  <Target Name="PublishLinuxX64" Condition="'$(IsWinX64)'=='true' or '$(IsLinuxX64)'=='true'">
    <MSBuild Projects="src/linux-x64/EMU7800.LinuxX64.csproj" Targets="Restore" />
    <MSBuild Projects="src/linux-x64/EMU7800.LinuxX64.csproj" Targets="Publish" Properties="Configuration=Release;PublishAot=$(LinuxX64PublishAot)" />
  </Target>
  <Target Name="PublishLinuxArm" Condition="'$(IsWinX64)'=='true' or '$(IsLinuxArm)'=='true'">
    <MSBuild Projects="src/linux-arm/EMU7800.LinuxArm.csproj" Targets="Restore" />
    <MSBuild Projects="src/linux-arm/EMU7800.LinuxArm.csproj" Targets="Publish" Properties="Configuration=Release;PublishAot=$(LinuxArmPublishAot)" />
  </Target>
  <Target Name="PublishLinuxArm64" Condition="'$(IsWinX64)'=='true' or '$(IsLinuxArm64)'=='true'">
    <MSBuild Projects="src/linux-arm64/EMU7800.LinuxArm64.csproj" Targets="Restore" />
    <MSBuild Projects="src/linux-arm64/EMU7800.LinuxArm64.csproj" Targets="Publish" Properties="Configuration=Release;PublishAot=$(LinuxArm64PublishAot)" />
  </Target>
  <Target Name="PublishOsXX64" Condition="'$(IsWinX64)'=='true' or '$(IsOsXX64)'=='true'">
    <MSBuild Projects="src/osx-x64/EMU7800.OsXX64.csproj" Targets="Restore" />
    <MSBuild Projects="src/osx-x64/EMU7800.OsXX64.csproj" Targets="Publish" Properties="Configuration=Release;PublishAot=$(OsXX64PublishAot)" />
  </Target>
  <Target Name="PublishOsXArm64" Condition="'$(IsWinX64)'=='true' or '$(IsOsXArm64)'=='true'">
    <MSBuild Projects="src/osx-arm64/EMU7800.OsXArm64.csproj" Targets="Restore" />
    <MSBuild Projects="src/osx-arm64/EMU7800.OsXArm64.csproj" Targets="Publish" Properties="Configuration=Release;PublishAot=$(OsXArm64PublishAot)" />
  </Target>
  <Target Name="CopySource">
    <MakeDir Directories="$(ArtifactsPath)\EMU7800.src" />
    <Copy SourceFiles="@(SourceArtifacts)"
          DestinationFiles="@(SourceArtifacts->'$(ArtifactsPath)\EMU7800.src\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          />
  </Target>
  <Target Name="ZipSrc" DependsOnTargets="CopySource">
    <ZipDirectory SourceDirectory="$(ArtifactsPath)\EMU7800.src"
                  DestinationFile="$(ArtifactsPath)\EMU7800.src.zip"
                  Overwrite="true"
                  />
  </Target>
  <Target Name="ZipRoms">
    <MakeDir Directories="$(ArtifactsPath)\ROMS" />
    <ZipDirectory SourceDirectory=".\lib\roms\Bios78"
                  DestinationFile="$(ArtifactsPath)\ROMS\Bios78.zip"
                  Overwrite="true"
                  />
    <ZipDirectory SourceDirectory=".\lib\roms\Atari"
                  DestinationFile="$(ArtifactsPath)\ROMS\Atari.zip"
                  Overwrite="true"
                  />
    <ZipDirectory SourceDirectory=".\lib\roms\Activision"
                  DestinationFile="$(ArtifactsPath)\ROMS\Activision.zip"
                  Overwrite="true"
                  />
    <ZipDirectory SourceDirectory=".\lib\roms\HomeBrews"
                  DestinationFile="$(ArtifactsPath)\ROMS\HomeBrews.zip"
                  Overwrite="true"
                  />
    <ZipDirectory SourceDirectory=".\lib\roms\Imagic"
                  DestinationFile="$(ArtifactsPath)\ROMS\Imagic.zip"
                  Overwrite="true"
                  />
    <ZipDirectory SourceDirectory=".\lib\roms\Other"
                  DestinationFile="$(ArtifactsPath)\ROMS\Other.zip"
                  Overwrite="true"
                  />
  </Target>
  <Target Name="CopyBinWinX64" DependsOnTargets="PublishWinX64;ZipRoms">
    <ItemGroup>
      <BinWin32Artifacts Include="$(ArtifactsPath)\publish\EMU7800.Win32\release_win-x64\**\*" />
      <RomArtifacts Include="$(ArtifactsPath)\ROMS\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(ArtifactsPath)\EMU7800.win-x64.bin" />
    <Copy SourceFiles="@(BinWin32Artifacts)"
          DestinationFiles="@(BinWin32Artifacts->'$(ArtifactsPath)\EMU7800.win-x64.bin\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          />
    <Copy SourceFiles="@(RomArtifacts)"
          DestinationFiles="@(RomArtifacts->'$(ArtifactsPath)\EMU7800.win-x64.bin\ROMS\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          />
  </Target>
  <Target Name="CopyBinWinX64Sdl3" DependsOnTargets="PublishWinX64Sdl3;ZipRoms">
    <ItemGroup>
      <BinWinSDL3Artifacts Include="$(ArtifactsPath)\publish\EMU7800.WinSDL3\release_win-x64\**\*;lib\SDL3.dll;lib\SDL3_ttf.dll;lib\SDL3_image.dll;lib\OpenSans-VariableFont.ttf" />
      <RomArtifacts Include="$(ArtifactsPath)\ROMS\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(ArtifactsPath)\EMU7800.win-x64-sdl3.bin" />
    <Copy SourceFiles="@(BinWinSDL3Artifacts)"
          DestinationFiles="@(BinWinSDL3Artifacts->'$(ArtifactsPath)\EMU7800.win-x64-sdl3.bin\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          />
    <Copy SourceFiles="@(RomArtifacts)"
          DestinationFiles="@(RomArtifacts->'$(ArtifactsPath)\EMU7800.win-x64-sdl3.bin\ROMS\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          />
  </Target>
  <Target Name="CopyBinLinuxX64" DependsOnTargets="PublishLinuxX64;ZipRoms">
    <ItemGroup>
      <BinLinuxX64Artifacts Include="$(ArtifactsPath)\publish\EMU7800.LinuxX64\release_linux-x64\**\*;lib\OpenSans-VariableFont.ttf" />
      <RomArtifacts Include="$(ArtifactsPath)\ROMS\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(ArtifactsPath)\EMU7800.linux-x64.bin"/>
    <Copy SourceFiles="@(BinLinuxX64Artifacts)"
          DestinationFiles="@(BinLinuxX64Artifacts->'$(ArtifactsPath)\EMU7800.linux-x64.bin\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          />
    <Copy SourceFiles="@(RomArtifacts)"
          DestinationFiles="@(RomArtifacts->'$(ArtifactsPath)\EMU7800.linux-x64.bin\ROMS\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          />
  </Target>
  <Target Name="CopyBinLinuxArm" DependsOnTargets="PublishLinuxArm;ZipRoms">
    <ItemGroup>
      <BinLinuxArmArtifacts Include="$(ArtifactsPath)\publish\EMU7800.LinuxArm\release_linux-arm\**\*;lib\OpenSans-VariableFont.ttf" />
      <RomArtifacts Include="$(ArtifactsPath)\ROMS\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(ArtifactsPath)\EMU7800.linux-arm.bin"/>
    <Copy SourceFiles="@(BinLinuxArmArtifacts)"
          DestinationFiles="@(BinLinuxArmArtifacts->'$(ArtifactsPath)\EMU7800.linux-arm.bin\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          />
    <Copy SourceFiles="@(RomArtifacts)"
          DestinationFiles="@(RomArtifacts->'$(ArtifactsPath)\EMU7800.linux-arm.bin\ROMS\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          />
  </Target>
  <Target Name="CopyBinLinuxArm64" DependsOnTargets="PublishLinuxArm64;ZipRoms">
    <ItemGroup>
      <BinLinuxArm64Artifacts Include="$(ArtifactsPath)\publish\EMU7800.LinuxArm64\release_linux-arm64\**\*;lib\OpenSans-VariableFont.ttf" />
      <RomArtifacts Include="$(ArtifactsPath)\ROMS\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(ArtifactsPath)\EMU7800.linux-arm64.bin" />
    <Copy SourceFiles="@(BinLinuxArm64Artifacts)"
          DestinationFiles="@(BinLinuxArm64Artifacts->'$(ArtifactsPath)\EMU7800.linux-arm64.bin\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          />
    <Copy SourceFiles="@(RomArtifacts)"
          DestinationFiles="@(RomArtifacts->'$(ArtifactsPath)\EMU7800.linux-arm64.bin\ROMS\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          />
  </Target>
  <Target Name="CopyBinOsXX64" DependsOnTargets="PublishOsXX64;ZipRoms">
    <ItemGroup>
      <BinOsXX64Artifacts Include="$(ArtifactsPath)\publish\EMU7800.OsXX64\release_osx-x64\**\*;lib\OpenSans-VariableFont.ttf" />
      <RomArtifacts Include="$(ArtifactsPath)\ROMS\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(ArtifactsPath)\EMU7800.osx-x64.bin"/>
    <Copy SourceFiles="@(BinOsXX64Artifacts)"
          DestinationFiles="@(BinOsXX64Artifacts->'$(ArtifactsPath)\EMU7800.osx-x64.bin\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          />
    <Copy SourceFiles="@(RomArtifacts)"
          DestinationFiles="@(RomArtifacts->'$(ArtifactsPath)\EMU7800.osx-x64.bin\ROMS\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          />
  </Target>
  <Target Name="CopyBinOsXArm64" DependsOnTargets="PublishOsXArm64;ZipRoms">
    <ItemGroup>
      <BinOsXArm64Artifacts Include="$(ArtifactsPath)\publish\EMU7800.OsXArm64\release_osx-arm64\**\*;lib\OpenSans-VariableFont.ttf" />
      <RomArtifacts Include="$(ArtifactsPath)\ROMS\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(ArtifactsPath)\EMU7800.osxarm64bin" />
    <Copy SourceFiles="@(BinOsXArm64Artifacts)"
          DestinationFiles="@(BinOsXArm64Artifacts->'$(ArtifactsPath)\EMU7800.osx-arm64.bin\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          />
    <Copy SourceFiles="@(RomArtifacts)"
          DestinationFiles="@(RomArtifacts->'$(ArtifactsPath)\EMU7800.osx-arm64.bin\ROMS\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          />
  </Target>
  <Target Name="ZipBinWinX64" DependsOnTargets="CopyBinWinX64">
    <ZipDirectory SourceDirectory="$(ArtifactsPath)\EMU7800.win-x64.bin"
                  DestinationFile="$(ArtifactsPath)\EMU7800.win-x64.bin.$(AssemblyVersion).zip"
                  Overwrite="true"
                  />
  </Target>
  <Target Name="ZipBinWinX64Sdl" DependsOnTargets="CopyBinWinX64Sdl3">
    <ZipDirectory SourceDirectory="$(ArtifactsPath)\EMU7800.win-x64-sdl3.bin"
                  DestinationFile="$(ArtifactsPath)\EMU7800.win-x64-sdl3.bin.$(AssemblyVersion).zip"
                  Overwrite="true"
                  />
  </Target>
  <Target Name="ZipBinLinuxX64" DependsOnTargets="CopyBinLinuxX64">
    <ZipDirectory SourceDirectory="$(ArtifactsPath)\EMU7800.linux-x64.bin"
                  DestinationFile="$(ArtifactsPath)\EMU7800.linux-x64.bin.$(AssemblyVersion).zip"
                  Overwrite="true"
                  />
  </Target>
  <Target Name="ZipBinLinuxArm" DependsOnTargets="CopyBinLinuxArm">
    <ZipDirectory SourceDirectory="$(ArtifactsPath)\EMU7800.linux-arm.bin"
                  DestinationFile="$(ArtifactsPath)\EMU7800.linux-arm.bin.$(AssemblyVersion).zip"
                  Overwrite="true"
                  />
  </Target>
  <Target Name="ZipBinLinuxArm64" DependsOnTargets="CopyBinLinuxArm64">
    <ZipDirectory SourceDirectory="$(ArtifactsPath)\EMU7800.linux-arm64.bin"
                  DestinationFile="$(ArtifactsPath)\EMU7800.linux-arm64.bin.$(AssemblyVersion).zip"
                  Overwrite="true"
                  />
  </Target>
  <Target Name="ZipBinOsXX64" DependsOnTargets="CopyBinOsXX64">
    <ZipDirectory SourceDirectory="$(ArtifactsPath)\EMU7800.osx-x64.bin"
                  DestinationFile="$(ArtifactsPath)\EMU7800.osx-x64.bin.$(AssemblyVersion).zip"
                  Overwrite="true"
                  />
  </Target>
  <Target Name="ZipBinOsXArm64" DependsOnTargets="CopyBinOsXArm64">
    <ZipDirectory SourceDirectory="$(ArtifactsPath)\EMU7800.osx-arm64.bin"
                  DestinationFile="$(ArtifactsPath)\EMU7800.osx-arm64.bin.$(AssemblyVersion).zip"
                  Overwrite="true"
                  />
  </Target>
  <Target Name="WinInstaller" DependsOnTargets="CopyBinWinX64" Condition="'$(IsWinX64)'=='true'">
    <Exec Command="dotnet clean Build.cs" WorkingDirectory="src/Tools/Installer" />
    <Exec Command="dotnet run Build.cs"   WorkingDirectory="src/Tools/Installer" />
  </Target>
  <Target Name="OsXX64"     DependsOnTargets="ZipBinOsXX64"     Condition="'$(IsWinX64)'=='true' or '$(IsOsXX64)'=='true'" />
  <Target Name="OsXArm64"   DependsOnTargets="ZipBinOsXArm64"   Condition="'$(IsWinX64)'=='true' or '$(IsOsXArm64)'=='true'" />
  <Target Name="LinuxX64"   DependsOnTargets="ZipBinLinuxX64"   Condition="'$(IsWinX64)'=='true' or '$(IsLinuxX64)'=='true'" />
  <Target Name="LinuxArm"   DependsOnTargets="ZipBinLinuxArm"   Condition="'$(IsWinX64)'=='true' or '$(IsLinuxArm)'=='true'" />
  <Target Name="LinuxArm64" DependsOnTargets="ZipBinLinuxArm64" Condition="'$(IsWinX64)'=='true' or '$(IsLinuxArm64)'=='true'" />
  <Target Name="WinX64"     DependsOnTargets="ZipBinWinX64"     Condition="'$(IsWinX64)'=='true'" />
  <Target Name="WinX64Sdl3" DependsOnTargets="ZipBinWinX64Sdl"  Condition="'$(IsWinX64)'=='true'" />
  <Target Name="Default"    DependsOnTargets="WinX64;WinX64Sdl3;LinuxArm;LinuxArm64;ZipSrc" />
  <Target Name="DefaultExp" DependsOnTargets="Default;OsXX64;OsXArm64;LinuxX64" />
</Project>
