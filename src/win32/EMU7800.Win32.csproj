<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>EMU7800</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>EMUIcon.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <OptimizationPreference>Speed</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StackTraceSupport>false</StackTraceSupport>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\shell\EMU7800.Shell.csproj" />
    <ProjectReference Include="..\win32.interop.pinvoke\EMU7800.Win32.Interop.PInvoke.csproj" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <LibFiles Include="$(ProjectDir)..\..\lib\EMU7800.Win32.Interop.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(LibFiles)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win-')) And '$(Configuration)' != 'Debug'">
    <DirectPInvoke Include="EMU7800.Win32.Interop.dll" />
    <NativeLibrary Include="$(ProjectDir)..\..\lib\EMU7800.Win32.Interop.lib" />
  </ItemGroup>
</Project>